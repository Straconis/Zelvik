<Window x:Class="Zelvik.App.DiscordSetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zelvik Discord Setup Wizard"
        Width="960"
        Height="760"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12">

            <TextBlock Text="Discord Setup Wizard"
                       FontSize="26"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="StepCounterText"
                       Margin="0,5,0,0"
                       Opacity="0.7"/>

        </StackPanel>

        <TextBlock x:Name="InstructionText"
                   Grid.Row="1"
                   Margin="0,0,0,14"
                   FontSize="15"
                   TextWrapping="Wrap"/>

        <Border Grid.Row="2"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,14">

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                <Image x:Name="StepImage"
                       Stretch="Uniform"/>

            </ScrollViewer>

        </Border>

        <StackPanel x:Name="TokenPanel"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Margin="0,0,0,14">

            <TextBlock Text="Discord Bot Token"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <PasswordBox x:Name="BotTokenPasswordBox"
                         MinWidth="400"
                         HorizontalAlignment="Left"/>

            <TextBlock Text="Paste the bot token you copied from the Discord Developer Portal. Zelvik will place it in Settings when you finish the wizard."
                       Margin="0,6,0,0"
                       Opacity="0.7"
                       TextWrapping="Wrap"/>

        </StackPanel>

        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Cancel"
                    MinWidth="90"
                    Padding="14,7"
                    Click="CancelButton_Click"/>

            <Button x:Name="BackButton"
                    Grid.Column="2"
                    Content="Back"
                    MinWidth="90"
                    Padding="14,7"
                    Click="BackButton_Click"/>

            <Button x:Name="NextButton"
                    Grid.Column="4"
                    Content="Next"
                    MinWidth="90"
                    Padding="14,7"
                    Click="NextButton_Click"/>

            <Button x:Name="FinishButton"
                    Grid.Column="6"
                    Content="Finish"
                    MinWidth="90"
                    Padding="14,7"
                    Visibility="Collapsed"
                    Click="FinishButton_Click"/>

        </Grid>

    </Grid>
</Window>
