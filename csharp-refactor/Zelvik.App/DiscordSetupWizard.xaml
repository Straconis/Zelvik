<Window x:Class="Zelvik.App.DiscordSetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zelvik - Guided Discord Setup"
        Width="940"
        Height="720"
        MinWidth="800"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12">

            <TextBlock Text="Discord Setup Wizard"
                       FontSize="26"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="StepCounterText"
                       Margin="0,5,0,0"
                       Opacity="0.7"/>

        </StackPanel>

        <!-- Content -->

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Step title and instructions -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,10">

                <TextBlock x:Name="TitleText"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="InstructionText"
                           Margin="0,6,0,0"
                           FontSize="15"
                           TextWrapping="Wrap"/>

            </StackPanel>

            <!-- Step-specific content -->

            <Grid Grid.Row="1">

                <!-- Screenshot steps -->

                <Border x:Name="StepImageBorder"
                        BorderThickness="1"
                        Padding="8"
                        Visibility="Collapsed">

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">

                        <Image x:Name="StepImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    </ScrollViewer>

                </Border>

                <!-- Token step -->

                <StackPanel x:Name="TokenPanel"
                            Visibility="Collapsed">

                    <TextBlock Text="Discord Bot Token"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="BotTokenPasswordBox"
                                     Grid.Column="0"
                                     MinWidth="400"
                                     VerticalContentAlignment="Center"/>

                        <TextBox x:Name="BotTokenTextBox"
                                 Grid.Column="0"
                                 MinWidth="400"
                                 Visibility="Collapsed"
                                 VerticalContentAlignment="Center"/>

                        <Button x:Name="PasteTokenButton"
                                Grid.Column="1"
                                Content="Paste"
                                Margin="8,0,0,0"
                                Padding="14,6"
                                Click="PasteTokenButton_Click"/>

                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0">

                        <CheckBox x:Name="ShowTokenCheckBox"
                                  Content="Show token"
                                  VerticalAlignment="Center"
                                  Checked="ShowTokenCheckBox_Checked"
                                  Unchecked="ShowTokenCheckBox_Unchecked"/>

                    </StackPanel>

                    <Button x:Name="TestTokenButton"
                            Content="Test Connection"
                            Width="150"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Padding="12,6"
                            Click="TestTokenButton_Click"/>

                    <Button x:Name="SaveTokenButton"
                            Content="Save Verified Token"
                            Width="170"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Padding="12,6"
                            IsEnabled="False"
                            Click="SaveTokenButton_Click"/>

                    <TextBlock x:Name="TokenStatusText"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Zelvik stores the token using Windows Credential Manager. The token is not written to Zelvik's settings files."
                               Margin="0,10,0,0"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>

                </StackPanel>

                <!-- Installation step -->

                <StackPanel x:Name="InstallPanel"
                            Visibility="Collapsed">

                    <Button x:Name="InstallBotButton"
                            Content="Add Zelvik to a Discord Server"
                            HorizontalAlignment="Left"
                            Margin="0,18,0,0"
                            Padding="14,7"
                            Click="InstallBotButton_Click"/>

                </StackPanel>

                <!-- Welcome step -->

                <StackPanel x:Name="WelcomePanel"
                            Visibility="Collapsed">

                    <Button x:Name="OpenDeveloperPortalButton"
                            Content="Open Discord Developer Portal"
                            HorizontalAlignment="Left"
                            Margin="0,18,0,0"
                            Padding="14,7"
                            Click="OpenDeveloperPortalButton_Click"/>

                </StackPanel>

                <!-- Completion step -->

                <StackPanel x:Name="FinishPanel"
                            Visibility="Collapsed">

                </StackPanel>

            </Grid>

        </Grid>
        <!-- Navigation -->

        <Grid Grid.Row="2"
              Margin="0,14,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Content="Back"
                    MinWidth="90"
                    Padding="14,7"
                    Click="BackButton_Click"/>

            <Button x:Name="CancelButton"
                    Grid.Column="2"
                    Content="Cancel"
                    MinWidth="90"
                    Padding="14,7"
                    Click="CancelButton_Click"/>

            <Button x:Name="NextButton"
                    Grid.Column="4"
                    Content="Next"
                    MinWidth="90"
                    Padding="14,7"
                    Click="NextButton_Click"/>

        </Grid>

    </Grid>

</Window>
