<Window x:Class="Zelvik.App.YouTubeLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Zelvik - YouTube Sign In"
        Width="1100"
        Height="760"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="YouTube Sign In"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="This browser profile belongs only to Zelvik."
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <TextBlock x:Name="LoginStatusText"
                           Grid.Column="1"
                           Text="Initializing..."
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Grid>
        </Border>

        <!-- BROWSER -->
        <wv2:WebView2 x:Name="YouTubeWebView"
                      Grid.Row="1"/>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CookieStatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Sign in to YouTube, then click Check Sign-In."
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                <Button Grid.Column="1"
                        Content="Check Sign-In"
                        Width="120"
                        Height="36"
                        Click="CheckLoginButton_Click"/>

                <Button Grid.Column="3"
                        Content="Test Cookie Export"
                        Width="140"
                        Height="36"
                        Click="TestCookieExportButton_Click"/>

                <Button Grid.Column="5"
                        Content="Close"
                        Width="90"
                        Height="36"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>