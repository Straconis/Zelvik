<Window x:Class="Zelvik.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zelvik"
        Width="760"
        Height="900"
        MinWidth="720"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="12">

            <!-- TOP STATUS -->
            <TextBlock x:Name="DiscordStatusText"
                       Text="Discord: Not connected"
                       Margin="0,0,0,6"/>

            <TextBlock x:Name="VoiceStatusText"
                       Text="Voice: Not connected"
                       Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Fill="#28D62F" Margin="0,0,7,0"/>
                    <TextBlock Text="Discord"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Fill="#FFE20A" Margin="0,0,7,0"/>
                    <TextBlock Text="Voice"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Fill="#FFE20A" Margin="0,0,7,0"/>
                    <TextBlock Text="Routing"/>
                </StackPanel>

                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Fill="#FFE20A" Margin="0,0,7,0"/>
                    <TextBlock Text="Source"/>
                </StackPanel>

                <StackPanel Grid.Column="8" Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Fill="#FFE20A" Margin="0,0,7,0"/>
                    <TextBlock x:Name="OverallReadyStatusText" Text="NOT READY"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Server" Margin="0,0,0,5"/>
            <ComboBox x:Name="ServerComboBox" Height="36" Margin="0,0,0,10"/>

            <TextBlock Text="Voice Channel" Margin="0,0,0,5"/>
            <ComboBox x:Name="VoiceChannelComboBox" Height="36" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="JoinChannelButton"
                        Grid.Column="0"
                        Content="Join Channel"
                        Height="38"/>

                <Button x:Name="LeaveChannelButton"
                        Grid.Column="2"
                        Content="Leave Channel"
                        Height="38"/>
            </Grid>

            <TextBlock Text="External Audio Inputs" Margin="0,0,0,10"/>

            <TextBlock x:Name="Input1VolumeLabel"
                       Text="Input 1 Volume: 100%"
                       Foreground="#3B9CFF"
                       Margin="0,0,0,5"/>

            <Slider x:Name="Input1VolumeSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="100"
                    Margin="0,0,0,8"
                    ValueChanged="VolumeSlider_ValueChanged"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="StartInput1Button"
                        Grid.Column="0"
                        Content="Start Input 1"
                        Height="38"/>

                <Button x:Name="StopInput1Button"
                        Grid.Column="2"
                        Content="Stop Input 1"
                        Height="38"/>
            </Grid>

            <TextBlock x:Name="Input1StatusText"
                       Text="Input 1: Stopped"
                       Foreground="#3B9CFF"
                       Margin="0,0,0,18"/>

            <TextBlock x:Name="Input2VolumeLabel"
                       Text="Input 2 Volume: 100%"
                       Foreground="#FF9800"
                       Margin="0,0,0,5"/>

            <Slider x:Name="Input2VolumeSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="100"
                    Margin="0,0,0,8"
                    ValueChanged="VolumeSlider_ValueChanged"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="StartInput2Button"
                        Grid.Column="0"
                        Content="Start Input 2"
                        Height="38"/>

                <Button x:Name="StopInput2Button"
                        Grid.Column="2"
                        Content="Stop Input 2"
                        Height="38"/>
            </Grid>

            <TextBlock x:Name="Input2StatusText"
                       Text="Input 2: Stopped"
                       Foreground="#FF9800"
                       Margin="0,0,0,24"/>

            <TextBlock Text="YouTube" Margin="0,0,0,7"/>

            <TextBox x:Name="YouTubeUrlTextBox"
                     Height="34"
                     Padding="7,4"
                     Margin="0,0,0,8"
                     ToolTip="YouTube URL or search term"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Start"
                           VerticalAlignment="Center"
                           Margin="0,0,7,0"/>

                <TextBox x:Name="YouTubeStartTextBox"
                         Grid.Column="1"
                         Height="32"
                         Text="00:00"
                         Padding="7,3"/>

                <TextBlock Grid.Column="3"
                           Text="Stop"
                           VerticalAlignment="Center"
                           Margin="0,0,7,0"/>

                <TextBox x:Name="YouTubeStopTextBox"
                         Grid.Column="4"
                         Height="32"
                         Padding="7,3"
                         ToolTip="Optional"/>

                <CheckBox x:Name="YouTubeLoopCheckBox"
                          Grid.Column="6"
                          Content="Loop"
                          VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="YouTubeVolumeLabel"
                       Text="Volume: 100%"
                       Margin="0,0,0,4"/>

            <Slider x:Name="MediaVolumeSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="100"
                    Margin="0,0,0,8"
                    ValueChanged="VolumeSlider_ValueChanged"/>

            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayYouTubeButton"
                        Grid.Column="0"
                        Content="Play YouTube"
                        Height="38"/>

                <Button x:Name="StopYouTubeButton"
                        Grid.Column="2"
                        Content="Stop YouTube"
                        Height="38"/>

                <Button x:Name="QueueYouTubeButton"
                        Grid.Column="4"
                        Content="Queue"
                        Height="38"/>
            </Grid>

            <TextBlock x:Name="YouTubeStatusText"
                       Text="YouTube: Stopped"
                       Margin="0,0,0,8"/>

            <TextBlock Text="YouTube Activity" Margin="0,0,0,5"/>

            <TextBox x:Name="YouTubeActivityTextBox"
                     Height="140"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="7"
                     Margin="0,0,0,22"
                     Text="YouTube playback activity will appear here."/>

            <TextBlock Text="Local File Playback" Margin="0,0,0,8"/>

            <TextBlock x:Name="LocalFileNameText"
                       Text="No sound selected"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="LocalMediaVolumeLabel"
                       Text="Volume: 85%"
                       Margin="0,0,0,4"/>

            <Slider x:Name="LocalMediaVolumeSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="85"
                    Margin="0,0,0,8"
                    ValueChanged="VolumeSlider_ValueChanged"/>

            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="SelectSoundButton"
                        Grid.Column="0"
                        Content="Select Sound"
                        Height="38"/>

                <Button x:Name="PlaySoundButton"
                        Grid.Column="2"
                        Content="Play Sound"
                        Height="38"/>

                <Button x:Name="StopLocalAudioButton"
                        Grid.Column="4"
                        Content="Stop Local Audio"
                        Height="38"/>
            </Grid>

            <TextBlock x:Name="LocalMediaStatusText"
                       Text="Local Audio: Stopped"
                       Margin="0,0,0,22"/>

            <TextBlock Text="Zelvik Input" Margin="0,0,0,7"/>

            <TextBlock Text="Virtual Windows Audio Endpoint"
                       FontWeight="SemiBold"
                       Margin="0,0,0,3"/>

            <TextBlock x:Name="VirtualInputStatusText"
                       Text="Driver not installed"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="VirtualInputVolumeLabel"
                       Text="Volume: 100%"
                       Margin="0,0,0,4"/>

            <Slider x:Name="VirtualInputVolumeSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="100"
                    Margin="0,0,0,22"
                    ValueChanged="VolumeSlider_ValueChanged"/>

            <TextBlock Text="Master Output" Margin="0,0,0,8"/>

            <TextBlock x:Name="MasterVolumeLabel"
                       Text="Master: 100%"
                       Margin="0,0,0,4"/>

            <Slider x:Name="MasterVolumeSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="100"
                    Margin="0,0,0,12"
                    ValueChanged="VolumeSlider_ValueChanged"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="SettingsButton"
                        Grid.Column="0"
                        Content="Settings"
                        Width="80"
                        Height="38"
                        Click="SettingsButton_Click"/>

                <Button x:Name="StopAllAudioButton"
                        Grid.Column="2"
                        Content="STOP ALL AUDIO"
                        Width="130"
                        Height="38"/>

                <Button x:Name="ExitButton"
                        Grid.Column="4"
                        Content="Exit"
                        Width="58"
                        Height="38"
                        Click="ExitButton_Click"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>