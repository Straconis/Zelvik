<Window x:Class="Zelvik.App.YouTubeQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Queue"
        Width="700"
        Height="560"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        AllowDrop="True">

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Add URL -->

        <Grid Grid.Row="0"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="QueueUrlTextBox"
                     Grid.Column="0"
                     Height="34"
                     Padding="7,4"
                     ToolTip="YouTube URL"/>

            <Button x:Name="AddQueueItemButton"
                    Grid.Column="2"
                    Content="Add"
                    Width="90"
                    Height="34"/>
        </Grid>

        <!-- Now playing -->

        <TextBlock Grid.Row="1"
                   Text="Now Playing"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"/>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SecondaryTextBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,16">

            <TextBlock x:Name="NowPlayingText"
                       Text="Nothing playing"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Queue -->

        <Grid Grid.Row="3">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Up Next"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,7"/>

            <ListBox x:Name="QueueListBox"
                     Grid.Row="1"
                     MinHeight="180"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="QueueListBox_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="QueueListBox_PreviewMouseMove"
                     Drop="QueueListBox_Drop"
                     MouseDoubleClick="QueueListBox_MouseDoubleClick"/>
        </Grid>

        <!-- Hint -->

        <TextBlock Grid.Row="4"
                   Text="Drag items to reorder them. Double-click an item to open it on YouTube."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,10,0,10"/>

        <!-- Controls -->

        <Grid Grid.Row="5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="PlayResumeButton"
                    Grid.Column="0"
                    Content="Play / Resume"
                    MinWidth="110"
                    Height="36"/>

            <Button x:Name="PlayNextButton"
                    Grid.Column="2"
                    Content="Play Next"
                    MinWidth="90"
                    Height="36"/>

            <Button x:Name="RemoveSelectedButton"
                    Grid.Column="4"
                    Content="Remove Selected"
                    MinWidth="120"
                    Height="36"/>

            <Button x:Name="ClearQueueButton"
                    Grid.Column="6"
                    Content="Clear Queue"
                    MinWidth="100"
                    Height="36"/>
        </Grid>

    </Grid>
</Window>
